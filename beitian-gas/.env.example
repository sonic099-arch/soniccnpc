# 请替换占位符；禁止提交真实密码。URL 中特殊字符需进行 URL 编码。
POSTGRES_USER=beitian
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=beitian
DATABASE_URL=postgresql+psycopg://beitian:CHANGE_ME_LOCAL_ONLY@localhost:5432/beitian
CORS_ORIGINS=["http://localhost:5173"]

# 可选：xlsx暂存目录，默认项目work/imports；只保存在运行机器本地，不提交Git。
# IMPORT_STORAGE_DIR=/absolute/path/to/local/imports

# 可选：已构建静态网页托管。推荐scripts/lan.py自动配置，不向内网开放后端端口。
# SERVE_FRONTEND=true
# WEB_DIST_DIR=/absolute/path/to/beitian-gas/frontend/dist
